float bayer4(vec2 p) {
  ivec2 q = ivec2(mod(floor(p), 4.0));
  int x = q.x, y = q.y ^ q.x;
  int v = ((y & 1) << 3) | ((x & 1) << 2) | (y & 2) | ((x & 2) >> 1);
  return (float(v) + 0.5) / 16.0;
}

vec4 applyFilter(vec4 c, vec2 uv) {
  float cellPx = max(floor(pix * resolution.y / 720.0 + 0.5), 1.0);
  vec2 cell = floor(uv * resolution / cellPx);
  vec2 cs = cellPx / resolution;
  vec3 lin = vec3(0.0);
  lin += lmToLinear(getColor((cell + vec2(0.25, 0.25)) * cs).rgb);
  lin += lmToLinear(getColor((cell + vec2(0.75, 0.25)) * cs).rgb);
  lin += lmToLinear(getColor((cell + vec2(0.25, 0.75)) * cs).rgb);
  lin += lmToLinear(getColor((cell + vec2(0.75, 0.75)) * cs).rgb);
  vec3 w = vec3(1.0, 1.4, 1.4);   // o matiz pesa um pouco mais: a cor não troca de família
  vec3 target = lmToOklab(lin * 0.25) * w;
  // Melhor cor sozinha.
  int ia = 0, ib = 0;
  float bestT = 0.0, bestE = 1.0e9;
  for (int i = 0; i < 16; i++) {
    vec3 e = LAB[i] * w - target;
    float err = dot(e, e);
    if (err < bestE) { bestE = err; ia = i; ib = i; }
  }
  // Melhor par: o ponto da mistura mais perto da cor e quanto de cada uma usar. Misturar cores muito distantes
  // cria um padrão gritante, por isso há uma pequena penalidade.
  for (int k = 0; k < 120; k++) {
    vec4 a = PAIR_A[k], d = PAIR_D[k];
    float t = clamp(dot(target - a.xyz, d.xyz) * d.w, 0.0, 1.0);
    vec3 e = a.xyz + d.xyz * t - target;
    float err = dot(e, e) + a.w * t * (1.0 - t) * dith;
    if (err < bestE) { bestE = err; ia = PAIR_I[k] / 16; ib = PAIR_I[k] - ia * 16; bestT = t; }
  }
  // Ordem fixa do par (a menor primeiro): células vizinhas com o mesmo par seguem o mesmo padrão.
  if (ia > ib) { int tmp = ia; ia = ib; ib = tmp; bestT = 1.0 - bestT; }
  // Sem pontilhado, fica a cor mais próxima das duas.
  float t = mix(step(0.5, bestT), bestT, dith);
  vec3 col = bayer4(cell) < t ? PALETTE[ib] : PALETTE[ia];
  return vec4(col, c.a);
}
