      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "id": "pixelate",
      "label": "Pixelar em vez de desfocar",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "id": "strength",
      "label": "Força",
      "type": "float",
      "default": 0.6,
      "min": 0.05,
      "max": 1
    },
    {
      "id": "feather",
      "label": "Borda suave",
      "type": "float",
      "default": 0.15,
      "min": 0,
      "max": 0.5
    }
  ]
